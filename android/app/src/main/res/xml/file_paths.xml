<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the clips subdirectory of the app cache is exposed. Recordings are
  written to cacheDir/clips/ and then copied into MediaStore; this provider is
  the share path when a MediaStore uri is unavailable, so a failed gallery save
  never costs the user their clip.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="epocheye_clips" path="clips/" />
</paths>
